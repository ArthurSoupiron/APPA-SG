{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "cd .. && bunx biome check backend",
    "format": "cd .. && bunx biome format --write backend",
    "dev": "bun --hot run src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bun --env-file=.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=.env x drizzle-kit migrate",
    "db:push": "bun --env-file=.env x drizzle-kit push",
    "db:push:force": "bun --env-file=.env x drizzle-kit push --force",
    "db:seed": "bun --env-file=.env run src/db/seed.ts",
    "db:fresh": "bun run db:push:force && bun run db:seed",
    "db:reset": "bun --env-file=.env run src/db/reset-database.ts",
    "db:rebuild": "bun run db:reset && bun run db:migrate && bun run db:seed",
    "db:rebuild:push": "bun run db:reset && bun run db:push:force && bun run db:seed",
    "db:studio": "bun --env-file=.env x drizzle-kit studio",
    "build": "bun x tsc --noEmit",
    "test": "bun test src/lib/missions src/routes/missions"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "better-auth": "^1.6.16",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "googleapis": "^173.0.0",
    "hono": "^4.12.25",
    "nodemailer": "^6.9.16",
    "@slack/web-api": "^7.16.0",
    "docxtemplater": "^3.68.7",
    "pizzip": "^3.2.0",
    "playwright": "^1.60.0",
    "pg": "^8.21.0"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "qs": "^6.15.2",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  }
}
